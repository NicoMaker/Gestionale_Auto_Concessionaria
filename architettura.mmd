flowchart TB
    subgraph BROWSER["🌐 Browser"]
        HTML["index.html"]
        CSS["css/style.css"]
        subgraph JS["JavaScript a componenti"]
            APP["app.js — router hash"]
            API_CLIENT["api.js — client fetch"]
            subgraph COMPONENTS["components/"]
                SIDEBAR["sidebar.js"]
                TOPBAR["topbar.js"]
                TABLE["table.js"]
                MODAL["modal.js"]
                TOAST["toast.js"]
            end
            subgraph PAGES["pages/"]
                DASH["dashboard.js"]
                AUTOP["auto.js"]
                CLIP["clienti.js"]
                MANP["manutenzioni.js"]
                NOLP["noleggi.js"]
            end
        end
    end

    subgraph SERVER["🖥️ Node.js + Express (server.js)"]
        STATIC["Static middleware\n(serve public/)"]
        subgraph ROUTES["routes/"]
            R_AUTO["/api/auto"]
            R_CLI["/api/clienti"]
            R_MAN["/api/manutenzioni"]
            R_NOL["/api/noleggi"]
        end
    end

    subgraph DB["🗄️ SQLite3 (db/gestionale.db)"]
        T_AUTO[(auto)]
        T_CLI[(clienti)]
        T_MAN[(manutenzioni)]
        T_NOL[(noleggi)]
    end

    HTML --> APP
    APP --> SIDEBAR & TOPBAR
    APP --> PAGES
    PAGES --> COMPONENTS
    PAGES --> API_CLIENT

    API_CLIENT -- "fetch /api/..." --> ROUTES
    STATIC -- "serve index.html, css, js" --> HTML

    R_AUTO --> T_AUTO
    R_CLI --> T_CLI
    R_MAN --> T_MAN
    R_NOL --> T_NOL

    T_AUTO -. "cliente_id" .-> T_CLI
    T_MAN -. "auto_id" .-> T_AUTO
    T_NOL -. "auto_id + cliente_id" .-> T_AUTO
    T_NOL -. " " .-> T_CLI
